{
  "name": "pup-blast",
  "version": "0.1.0",
  "private": true,
  "description": "Block puzzle with a puppy gacha. Web core wrapped for iOS with Capacitor.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "build:preview": "node scripts/build-single.mjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:setup": "node scripts/ios-setup.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/native-purchases": "^8.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}

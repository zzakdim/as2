{
  "name": "pup-blast",
  "version": "0.1.0",
  "private": true,
  "description": "Block puzzle with a puppy gacha. Web core wrapped for iOS with Capacitor.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "serve": "npx --yes http-server www -p 8080 -c-1",
    "build:preview": "node scripts/build-single.mjs",
    "ios:add": "npx cap add ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.0.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/preferences": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  }
}

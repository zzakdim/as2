# Uploads the App Store text (every language) from fastlane/metadata. Run from pup_blast/: fastlane deliver
# Text only: no build, no screenshots, nothing submitted for review. Review it in App Store Connect, then submit there.
app_identifier("com.bonepile.pupblast")
app_version("1.1")
api_key_path("fastlane/asc_api_key.json")
metadata_path("./fastlane/metadata")
skip_binary_upload(true)
skip_screenshots(true)
skip_app_version_update(false)
submit_for_review(false)
automatic_release(false)
force(true) # no HTML preview to confirm in the browser
precheck_include_in_app_purchases(false)
